# Copie para .env e ajuste. Valores abaixo servem só para desenvolvimento local.

POSTGRES_PASSWORD=postgres_dev
# Senha de cada banco (padrão = nome do banco, ex.: hub_bank)
# HUB_BANK_DB_PASSWORD=

GRAFANA_ADMIN_PASSWORD=admin_dev

# Chave AES-256 (Base64) que cifra as chaves de assinatura dos tokens. Gere a sua: openssl rand -base64 32
# Valor abaixo SOMENTE para desenvolvimento.
HUB_AUTH_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=
# Cifra credenciais e certificados das integrações (gere a sua do mesmo jeito). SOMENTE desenvolvimento:
HUB_INTEGRATION_ENCRYPTION_KEY=aW50ZWdyYXRpb24tZGV2LWtleS1ub3QtZm9yLXByb2Q=

# "default,dev" cria instituições e usuários de exemplo (senha Hub@dev2026!). Em outros ambientes: default
LIQUIBASE_CONTEXTS=default,dev

# Primeiro SUPER_ADMIN em ambientes sem o seed de desenvolvimento
# HUB_AUTH_BOOTSTRAP_ADMIN_EMAIL=
# HUB_AUTH_BOOTSTRAP_ADMIN_PASSWORD=

HUB_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Versões das imagens de infraestrutura
POSTGRES_IMAGE=postgres:18-alpine
RABBITMQ_IMAGE=rabbitmq:4.1-management-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.1.1
JAEGER_IMAGE=jaegertracing/jaeger:2.9.0
REDIS_IMAGE=redis:7.4-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.27
