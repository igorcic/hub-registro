<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>br.com.hubregistro</groupId>
    <artifactId>hub-registro</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Hub de Registro de Contratos Imobiliários</name>

    <modules>
        <module>libs/hub-starter-observability</module>
        <module>libs/hub-starter-messaging</module>
        <module>libs/hub-database-support</module>
        <module>libs/hub-test-support</module>
        <module>services/api-gateway</module>
        <module>services/auth-service</module>
        <module>services/bank-service</module>
        <module>services/registry-service</module>
        <module>services/contract-service</module>
        <module>services/document-service</module>
        <module>services/routing-service</module>
        <module>services/integration-service</module>
        <module>services/notification-service</module>
        <module>services/audit-service</module>
        <module>services/operations-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <archunit.version>1.4.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.hubregistro</groupId>
                <artifactId>hub-starter-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.hubregistro</groupId>
                <artifactId>hub-starter-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.hubregistro</groupId>
                <artifactId>hub-database-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.hubregistro</groupId>
                <artifactId>hub-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Testes *IT precisam de Docker (Testcontainers) e rodam em "mvn verify";
                 "mvn test" executa só os testes unitários. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
